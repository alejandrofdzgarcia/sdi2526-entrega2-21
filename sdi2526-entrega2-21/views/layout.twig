<!DOCTYPE html>
<html>
<head>
  <title>{% block title %}Space Management{% endblock %}</title>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <link rel="stylesheet"
        href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css"/>
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.2.0/jquery.min.js"></script>
  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
  {% block scripts %}{% endblock %}
</head>
<body>
{% block body %}{% endblock %}

<nav class="navbar navbar-inverse">
    <div class="container-fluid">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#myNavbar">
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            <a class="navbar-brand" href="/">SDI Reservas</a>
        </div>
        <div class="collapse navbar-collapse" id="myNavbar">
            <ul class="nav navbar-nav">
                {% if sessionUser %}
                    <li><a href="/spaces/list">Espacios</a></li>

                    {% if sessionRole == 'Administrador' %}
                        <li class="dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                Administración <span class="caret"></span>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a href="/admin/spaces/list">Gestión de Espacios</a></li>
                                <li><a href="/admin/maintenance/list">Bloqueos de Mantenimiento</a></li>
                                <li><a href="/admin/reservations/list">Listado Global de Reservas</a></li>
                                <li><a href="/admin/users/list">Listado de Usuarios</a></li>
                            </ul>
                        </li>
                    {% endif %}
                {% endif %}
            </ul>

            <ul class="nav navbar-nav navbar-right">
                {% if sessionUser %}
                    <li class="navbar-text">
                        Hola, <strong>{{ sessionNombre }}</strong>
                        {% if sessionRole == 'Administrador' %}
                            <span class="label label-danger" style="margin-left:4px">Admin</span>
                        {% endif %}
                    </li>
                    <li><a href="/users/change-password"><span class="glyphicon glyphicon-lock"></span> Cambiar contraseña</a></li>
                    <li><a href="/users/logout"><span class="glyphicon glyphicon-log-out"></span> Cerrar sesión</a></li>
                {% else %}
                    <li><a href="/users/signup"><span class="glyphicon glyphicon-user"></span> Registrarte</a></li>
                    <li><a href="/users/login"><span class="glyphicon glyphicon-log-in"></span> Identificarte</a></li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

    <div class="container">
      <div class="container" id="main-container">
          <script>
              window.addEventListener('DOMContentLoaded', function() {
                  var params = new URLSearchParams(location.search);
                  var message = params.get("message");
                  var messageType = params.get("messageType");
                  if (message !== null && message !== "") {
                      if (!messageType || messageType === "") {
                          messageType = 'alert-info';
                      }
                      var div = document.createElement('div');
                      div.className = 'alert ' + messageType;
                      div.textContent = message;
                      var container = document.getElementById('main-container');
                      if (container) {
                          container.insertBefore(div, container.firstChild);
                      }
                  }
              });
          </script>
        <!-- Contenido -->
        {% block main_container %}
          <!-- Posible contenido por defecto -->
        {% endblock %}
      </div>
    </div>
  </body>
</html>