{% extends "layout.twig" %}
{% block title %}{{ title }}{% endblock %}
{% block main_container %}

<div class="container" id="main-container">
    <div class="row">
        <div class="col-sm-8 col-sm-offset-2">
            <h2>{{ title }}</h2>

            {% if errors is not empty %}
                <div class="alert alert-danger">
                    <ul class="list-unstyled" style="margin-bottom:0">
                        {% for error in errors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <form method="post"
                  action="{% if isEdit %}/admin/spaces/{{ space._id }}/edit{% else %}/admin/spaces/new{% endif %}">

                <div class="form-group">
                    <label for="name">Nombre <span class="text-danger">*</span></label>
                    <input type="text" id="name" name="name" class="form-control"
                           value="{{ space.name }}" required>
                </div>

                <div class="form-group">
                    <label for="type">Tipo <span class="text-danger">*</span></label>
                    <select id="type" name="type" class="form-control" required>
                        <option value="SALA"   {% if space.type == 'SALA' %}selected{% endif %}>Sala</option>
                        <option value="AULA"   {% if space.type == 'AULA' %}selected{% endif %}>Aula</option>
                        <option value="COWORK" {% if space.type == 'COWORK' %}selected{% endif %}>Cowork</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="location">Ubicación</label>
                    <input type="text" id="location" name="location" class="form-control"
                           value="{{ space.location }}">
                </div>

                <div class="form-group">
                    <label for="capacity">Capacidad <span class="text-danger">*</span></label>
                    <input type="number" id="capacity" name="capacity" class="form-control"
                           value="{{ space.capacity }}" min="1" required>
                </div>

                <div class="form-group">
                    <label for="description">Descripción</label>
                    <textarea id="description" name="description" class="form-control"
                              rows="3">{{ space.description }}</textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    {% if isEdit %}Guardar Cambios{% else %}Registrar Espacio{% endif %}
                </button>
                <a href="/admin/spaces/list" class="btn btn-default">Cancelar</a>
            </form>
        </div>
    </div>
</div>

{% endblock %}
