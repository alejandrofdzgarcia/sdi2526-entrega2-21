{% extends "layout.twig" %}
{% block title %}Nuevo Bloqueo de Mantenimiento{% endblock %}
{% block main_container %}

<div class="container" id="main-container">
    <div class="row">
        <div class="col-sm-8 col-sm-offset-2">
            <h2>Nuevo Bloqueo de Mantenimiento</h2>
            <p class="text-muted">Espacio: <strong>{{ space.name }}</strong> ({{ space.type }} · {{ space.location }})</p>

            {% if errors is not empty %}
                <div class="alert alert-danger">
                    <ul class="list-unstyled" style="margin-bottom:0">
                        {% for error in errors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <form method="post" action="/admin/spaces/{{ space._id }}/maintenance/new">
                <div class="form-group">
                    <label for="startDate">Fecha/Hora de Inicio <span class="text-danger">*</span></label>
                    <input type="datetime-local" id="startDate" name="startDate"
                           class="form-control" value="{{ formData.startDate }}" required>
                </div>
                <div class="form-group">
                    <label for="endDate">Fecha/Hora de Fin <span class="text-danger">*</span></label>
                    <input type="datetime-local" id="endDate" name="endDate"
                           class="form-control" value="{{ formData.endDate }}" required>
                </div>
                <div class="form-group">
                    <label for="reason">Motivo <span class="text-danger">*</span></label>
                    <textarea id="reason" name="reason" class="form-control"
                              rows="3" required>{{ formData.reason }}</textarea>
                </div>
                <button type="submit" class="btn btn-warning">Crear Bloqueo</button>
                <a href="/admin/spaces/list" class="btn btn-default">Cancelar</a>
            </form>
        </div>
    </div>
</div>

{% endblock %}
