{% extends "layout.twig" %}
{% block title %} Cambiar contraseña {% endblock %}
{% block main_container %}
    <h2>Cambiar contraseña</h2>
    <form class="form-horizontal" method="post" action="/users/change-password">
        <div class="form-group">
            <label class="control-label col-sm-3" for="currentPassword">Contraseña actual:</label>
            <div class="col-sm-9">
                <input id="currentPassword" type="password" class="form-control" name="currentPassword"
                       placeholder="Contraseña actual" required="true"/>
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-sm-3" for="newPassword">Nueva contraseña:</label>
            <div class="col-sm-9">
                <input id="newPassword" type="password" class="form-control" name="newPassword"
                       placeholder="Nueva contraseña" required="true"/>
                <span class="help-block">Entre 12 y 20 caracteres, al menos 1 mayúscula, 1 minúscula, 1 dígito, 1 carácter especial y sin espacios.</span>
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-sm-3" for="confirmNewPassword">Confirmar nueva contraseña:</label>
            <div class="col-sm-9">
                <input id="confirmNewPassword" type="password" class="form-control" name="confirmNewPassword"
                       placeholder="Confirmar nueva contraseña" required="true"/>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-offset-3 col-sm-9">
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
            </div>
        </div>
    </form>
{% endblock %}