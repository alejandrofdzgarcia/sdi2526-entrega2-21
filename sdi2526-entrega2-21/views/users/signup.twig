{% extends "layout.twig" %}
{% block title %}Registro de Usuario{% endblock %}
{% block main_container %}

<div class="container" id="main-container">
    <div class="row">
        <div class="col-sm-6 col-sm-offset-3">
            <h2>Registro de Usuario</h2>

            {% if errors is not empty %}
                <div class="alert alert-danger">
                    <ul class="list-unstyled" style="margin-bottom:0">
                        {% for error in errors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <form method="post" action="/signup">
                <div class="form-group">
                    <label for="dni">DNI <span class="text-danger">*</span></label>
                    <input type="text" id="dni" name="dni" class="form-control"
                           placeholder="12345678A" value="{{ formData.dni }}" maxlength="9" required>
                </div>
                <div class="form-group">
                    <label for="name">Nombre <span class="text-danger">*</span></label>
                    <input type="text" id="name" name="name" class="form-control"
                           value="{{ formData.name }}" required>
                </div>
                <div class="form-group">
                    <label for="lastname">Apellidos <span class="text-danger">*</span></label>
                    <input type="text" id="lastname" name="lastname" class="form-control"
                           value="{{ formData.lastname }}" required>
                </div>
                <div class="form-group">
                    <label for="password">Contraseña <span class="text-danger">*</span></label>
                    <input type="password" id="password" name="password" class="form-control" required>
                    <small class="help-block">12–20 caracteres, con mayúscula, minúscula, dígito y carácter especial. Sin espacios.</small>
                </div>
                <div class="form-group">
                    <label for="confirmPassword">Confirmar Contraseña <span class="text-danger">*</span></label>
                    <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" required>
                </div>
                <button type="submit" class="btn btn-primary btn-block">Registrarse</button>
                <hr>
                <p class="text-center">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
            </form>
        </div>
    </div>
</div>

{% endblock %}
